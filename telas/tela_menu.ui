      <widget class="QWidget" name="pageConfiguracoes">
       <property name="styleSheet">
        <string notr="true">
QWidget#pageConfiguracoes {
    background-color: #FFFFFF;
}
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #;
    border-radius: 12px;
    margin-top: 0px;
    padding: 15px;
}
QLabel {
    color: #4A5568;
    font-size: 13px;
    background-color: transparent;
}
QLabel#lblTituloTela {
    color: #1A202C;
    font-size: 20px;
    font-weight: bold;
}
QLabel#lblSubTela, QLabel#lblSubInfo, QLabel#lblSubUsuarios, QLabel#lblSubBanco, QLabel#lblSubSobre, QLabel#lblAvisoRodape {
    color: #FFFFFF;
    font-size: 12px;
}
QLabel#lblTituloInfo, QLabel#lblTituloUsuarios, QLabel#lblTituloBanco, QLabel#lblTituloSobre {
    color: #3F4A2F;
    font-size: 15px;
    font-weight: bold;
}
QLineEdit, QTimeEdit {
    border: 2px solid #3F4A2F;
    border-radius: 6px;
    padding: 6px;
    background-color: #FFFFFF;
    color: #333333;
}
QLineEdit:focus, QTimeEdit:focus {
    border: 2px solid #2E3723;
}
QPushButton {
    background-color: #3F4A2F;
    color: #E6D2A2;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #2E3723;
}
QPushButton.btnAcaoCard {
    background-color: #FFFFFF;
    color: #4A5568;
    border: 2px solid #3F4A2F;
    border-radius: 6px;
    padding: 10px;
    text-align: left;
    font-size: 13px;
}
QPushButton.btnAcaoCard:hover {
    background-color: #F7FAFC;
    color: #3F4A2F;
}
        </string>
