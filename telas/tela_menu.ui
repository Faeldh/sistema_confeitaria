      <widget class="QWidget" name="pageControleFinanceiro">
       <property name="styleSheet">
        <string notr="true">QWidget#pageControleFinanceiro {
    background-color: #F8FAFC; 
}
QFrame#cardFaturamento, 
QFrame#cardVendasConcluidas,
QFrame#cardTicketMedio,
QFrame#cardItensVendidos,
QFrame#cardCozinha, 
QFrame#cardAtrasados, 
QFrame#cardLargeResumo, 
QFrame#cardLargeMaisVendidos {
    background-color: #3F4A2F; 
    border: 1px solid #000000;  
    border-radius: 12px;
}
QLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #E6D2A2; 
}
QLabel#lblTituloFat, QLabel#lblTituloVendas, QLabel#lblTituloTicket, 
QLabel#lblTituloItens, QLabel#lblTituloCoz, QLabel#lblTituloAtr, 
QLabel#lblSecaoResumo, QLabel#lblSecaoMaisVendidos {
    font-size: 11px;
    color: #E6D2A2; 
    font-weight: bold;
    text-transform: uppercase;
}
QLabel#lblValorFat, QLabel#lblValorVendas, QLabel#lblValorTicket, 
QLabel#lblValorItens, QLabel#lblValorCoz, QLabel#lblValorAtr {
    font-size: 22px; 
    color: #E6D2A2; 
    font-weight: bold;
}
QLabel#lblSubFat, QLabel#lblSubVendas, QLabel#lblSubTicket, 
QLabel#lblSubItens, QLabel#lblSubCoz, QLabel#lblSubAtr {
    font-size: 11px;
    color: #E6D2A2;
    opacity: 0.8;
}
QLabel#lblMainTitle {
    color: #3F4A2F; 
    font-size: 20px;
    font-weight: bold;
}
QLabel#lblMainSub {
    color: #3F4A2F;
    font-size: 12px;
}</string>
