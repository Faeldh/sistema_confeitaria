  <property name="styleSheet">
   <string notr="true">QMainWindow {
	border-top-color: rgb(255, 255, 255);
    background-color: #FFFFFF;
}

/* BOTÕES */
QPushButton {
    background-color: #3F4A2F;
    color: #E6D2A2;
    border-radius: 10px;
    padding: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2E3723;
}

/* CAMPOS */
QLineEdit, QTextEdit, QComboBox, QDateEdit {
    border: 2px solid #3F4A2F;
    border-radius: 8px;
    padding: 5px;
    background-color: white;
}

/* GRUPOS */
QGroupBox {
    border: 2px solid #3F4A2F;
    border-radius: 10px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #3F4A2F;
}

/* TABELA */
QTableWidget {
    background-color: white;
    border-radius: 10px;
    gridline-color: #DDD;
}

/* LABEL DE PREÇO (NOVO - IMPORTANTE) */
QLabel#lblPrecoProduto {
    background-color: #3F4A2F;
    color: #E6D2A2;
    border-radius: 10px;
    padding: 5px 10px;
    font-weight: bold;
}

/* LABEL NORMAL (opcional para destacar valores) */
QLabel {
    color: #2E3723;
}</string>
